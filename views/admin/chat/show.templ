package admin_chat

import (
	"fmt"
	"github.com/ryotaro/yoyaku-multi/internal/model"
	"github.com/ryotaro/yoyaku-multi/views/layout"
)

templ Show(applicant *model.Applicant, messages []*model.ChatMessage) {
	@layout.AdminBase(applicant.Handle + " チャット", "applicants") {
		<div class="page-header">
			<h1 class="page-title">{ applicant.Handle } とのチャット</h1>
			<a href="/admin/applicants" class="btn btn-secondary">← 参加者一覧</a>
		</div>

		<div style="max-width: 680px;">
			<div
				class="chat-container"
				id="chat-messages"
				hx-get={ fmt.Sprintf("/admin/chat/%s/messages", applicant.ID.String()) }
				hx-trigger="every 10s"
				hx-swap="innerHTML"
			>
				@Messages(messages)
			</div>
			<form
				class="chat-form"
				hx-post={ fmt.Sprintf("/admin/chat/%s", applicant.ID.String()) }
				hx-target="#chat-messages"
				hx-swap="innerHTML"
				hx-on::after-request="this.reset()"
			>
				<input class="form-control" type="text" name="body" placeholder="メッセージを入力..." required autocomplete="off"/>
				<button type="submit" class="btn btn-primary">送信</button>
			</form>
		</div>
	}
}

templ Messages(messages []*model.ChatMessage) {
	for _, msg := range messages {
		<div>
			<div class={ fmt.Sprintf("chat-bubble chat-bubble--%s", msg.Sender) }>
				{ msg.Body }
			</div>
			<div class={ fmt.Sprintf("chat-meta chat-meta--%s", msg.Sender) }>
				if msg.Sender == "admin" {
					管理者 { msg.CreatedAt.Format("1/2 15:04") }
				} else {
					参加者 { msg.CreatedAt.Format("1/2 15:04") }
				}
			</div>
		</div>
	}
}
