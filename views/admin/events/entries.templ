package admin_events

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/ryotaro/yoyaku-multi/internal/model"
	"github.com/ryotaro/yoyaku-multi/views/layout"
)

templ Entries(event *model.Event, entries []*model.EntryWithApplicant, optionSet *model.OptionSet) {
	@layout.AdminBase("参加表明者一覧", "events") {
		<div class="page-header">
			<h1 class="page-title">
				{ event.EventDate.Format("2006/01/02") } { event.EventTime.Format("15:04") } 参加表明者
			</h1>
			<a href="/admin/events" class="btn btn-secondary">← 一覧に戻る</a>
		</div>

		<div class="flex gap-sm mb-md">
			<span class="badge badge-open">{ fmt.Sprintf("%d名の表明", activeEntryCount(entries)) }</span>
			<span class="badge badge-open">{ fmt.Sprintf("定員%d名", event.Capacity) }</span>
		</div>

		if len(entries) == 0 {
			<div class="card" style="text-align: center;">
				<p class="text-muted">まだ参加表明がありません。</p>
			</div>
		} else {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/events/%s/confirm", event.ID.String())) }>
				<div class="table-wrap mb-md">
					<table>
						<thead>
							<tr>
								<th>選択</th>
								<th>ハンドル</th>
								<th>表明日時</th>
								<th>ステータス</th>
								for _, item := range optionSet.Items {
									<th>{ item.Label }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, entry := range entries {
								<tr>
									<td>
										if entry.Status == "pending" {
											<input type="checkbox" name="applicant_ids" value={ entry.ApplicantID.String() }/>
										}
									</td>
									<td>{ entry.Handle }</td>
									<td>{ entry.CreatedAt.Format("1/2 15:04") }</td>
									<td>{ entryStatusLabel(entry.Status) }</td>
									for _, item := range optionSet.Items {
										<td>{ optionBadge(entry.SelectedOptionItemIDs, item.ID) }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>

				if event.Status == "open" {
					<div class="flex gap-sm">
						<button type="submit" class="btn btn-primary" onclick="return confirm('選択した参加者を確定しますか？確定後は変更できません。')">
							参加者を確定する
						</button>
						<button
							type="submit"
							formaction={ templ.SafeURL(fmt.Sprintf("/admin/events/%s/decline", event.ID.String())) }
							class="btn btn-secondary"
						>
							見送り通知を送る（任意）
						</button>
					</div>
				}
			</form>

			if len(entries) >= 2 {
				<hr class="divider"/>
				<h2 class="mypage-section-title">オプション比較ビュー</h2>
				<p class="text-muted text-sm mb-md">2名を選ぶと、選択オプションの比較が表示されます。</p>
				<form
					hx-get={ fmt.Sprintf("/admin/events/%s/entries/compare", event.ID.String()) }
					hx-target="#compare-result"
					hx-trigger="change"
				>
					<div class="flex gap-md flex-wrap mb-md">
						for _, entry := range entries {
							<label style="display: flex; align-items: center; gap: var(--space-sm);">
								<input type="checkbox" name="ids" value={ entry.ApplicantID.String() }/>
								{ entry.Handle }
							</label>
						}
					</div>
				</form>
				<div id="compare-result"></div>
			}
		}
	}
}

templ CompareView(entries []*model.EntryWithApplicant, optionSet *model.OptionSet) {
	if len(entries) != 2 {
		<p class="text-muted">2名を選択してください。</p>
	} else {
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>行為</th>
						<th>{ entries[0].Handle }</th>
						<th>{ entries[1].Handle }</th>
						<th>判定</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range optionSet.Items {
						<tr class={ compareRowClass(entries[0].SelectedOptionItemIDs, entries[1].SelectedOptionItemIDs, item.ID) }>
							<td>{ item.Label }</td>
							<td>{ optionBadge(entries[0].SelectedOptionItemIDs, item.ID) }</td>
							<td>{ optionBadge(entries[1].SelectedOptionItemIDs, item.ID) }</td>
							<td>{ compareResult(entries[0].SelectedOptionItemIDs, entries[1].SelectedOptionItemIDs, item.ID) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func activeEntryCount(entries []*model.EntryWithApplicant) int {
	count := 0
	for _, entry := range entries {
		if entry.Status == "pending" || entry.Status == "confirmed" {
			count++
		}
	}
	return count
}

func entryStatusLabel(s string) string {
	switch s {
	case "pending":
		return "表明中"
	case "confirmed":
		return "確定"
	case "declined":
		return "見送り"
	case "cancelled":
		return "取消"
	}
	return s
}

func optionBadge(selected []uuid.UUID, itemID uuid.UUID) string {
	for _, selectedID := range selected {
		if selectedID == itemID {
			return "選択"
		}
	}
	return "-"
}

func isOptionSelected(selected []uuid.UUID, itemID uuid.UUID) bool {
	for _, selectedID := range selected {
		if selectedID == itemID {
			return true
		}
	}
	return false
}

func compareRowClass(s1, s2 []uuid.UUID, itemID uuid.UUID) string {
	selected1 := isOptionSelected(s1, itemID)
	selected2 := isOptionSelected(s2, itemID)
	if selected1 && selected2 {
		return "ng-both-ok"
	}
	if !selected1 && !selected2 {
		return "ng-both-ng"
	}
	return "ng-one-ng"
}

func compareResult(s1, s2 []uuid.UUID, itemID uuid.UUID) string {
	selected1 := isOptionSelected(s1, itemID)
	selected2 := isOptionSelected(s2, itemID)
	if selected1 && selected2 {
		return "両者選択"
	}
	if !selected1 && !selected2 {
		return "未選択"
	}
	return "片方のみ"
}
